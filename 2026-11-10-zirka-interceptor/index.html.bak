ue"/></video></div><div class="video-layer"></div><div class="w-embed w-script">
</div></div></div><div class="line-text"><div class="line-wrap-zero hide"></div><div class="line-wrap"><div class="line-wrap-item"></div><div class="line-wrap-item"></div><div class="line-wrap-item"></div><div class="line-wrap-item"></div><div class="line-wrap-item"></div><div class="line-wrap-item"></div><div class="line-wrap-item"></div><div class="line-wrap-item"></div><div class="line-wrap-item"></div><div class="line-wrap-item"></div></div><div data-w-id="7f5d44d3-409d-8809-d6ce-37f0b035aee2" class="line-text-wrap-h"><div class="line-text-wrap"><div class="line-text-wrap-copy"><div class="scene"><div class="line-text-wrap-item"><div class="line-text-wrap-item-line-1"><div delay="0.7" data-text-fade-in="">Shaheds are the world’s main</div></div><div class="line-text-wrap-item-line-2"><div delay="0.7" data-text-fade-in="" class="line-text-wrap-item-line-2-1">main security</div><img src="assets/img/6a6b45050da8002d7ece658d_Cross_Target.webp" loading="lazy" sizes="100vw" alt="" class="cross hide"/><img src="assets/img/6a4281712b40a844defb5fe9_Cross_Target.png" class="cross"/><div delay="0.7" data-text-fade-in="" class="line-text-wrap-item-line-2-2">threat</div></div></div></div><div class="step-3-bot"><div scrub="">//</div><div class="step-1-top-text-wrap"><div scrub="">THREAT CLASS — SHAHED-TYPE UAS</div><div scrub="" class="text-padding">UNIT COST: ~$50,000</div><div scrub="" class="text-padding">SPEED: 185 KM/H — ALT: LOW</div><div scrub="">};</div><div scrub="">PRIORITY: CRITICAL</div></div></div></div></div></div><div class="line-text-bg"></div></div><div class="number-sec-wrap"><div id="effectiveness" class="number-sec"><div class="container full"><div class="num-sec-wrap"><div class="cent-text"><div class="h2block"><p class="h2 t-white t-grey">Launches</p><div id="regionMask" class="h2 mask reveal"><div id="regionA" class="line t-grey">Ukraine</div><div id="regionB" class="line t-grey">Middle East</div></div></div><div class="index h2"><div class="mask reveal digit-mask"><div id="idxA" class="line t-white">02</div><div id="idxB" class="line t-white">01</div></div><div class="t-grey">/ 02</div></div></div></div></div><div class="number-sec-abs-wrap"><img src="assets/img/6a6b45050da8002d7ece6567_Ellipse_2.svg" loading="lazy" alt="" class="image"/><div class="number-sec-abs-wrap-num-wrap"><div class="header-top-line-wrap set"></div><div class="counter"><div class="counter-frame counter-frame--top"></div><div class="counter-frame counter-frame--bottom"></div><div id="digits" class="digit num"></div></div><div class="header-bot-line-wrap set-2"></div></div><img src="assets/img/6a6b45050da8002d7ece656a_Frame_427320578.svg" loading="lazy" alt="" class="image-2"/></div><div class="hide w-embed w-script"><!--




